# Não armazene tokens aqui. O Codex usa seu login ChatGPT oficial.
# Variáveis opcionais de execução, lidas pela CLI:
# VENDREX_DATA=C:\Vendrex\dados

# Vercel proxy: configuration only. No Meta or service_role secret here.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_CONFIGURE_IN_PLATFORM
# PUBLIC_BASE_URL=https://YOUR_AUTHORIZED_COMMERCIAL_HOST

# Local Growth bridge: authenticated Supabase user session, never a Meta token.
# VENDREX_SUPABASE_URL=https://PROJECT_REF.supabase.co
# VENDREX_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CONFIGURE_SECURELY
# VENDREX_SUPABASE_ACCESS_TOKEN=CONFIGURE_SECURELY_NOT_IN_SOURCE
